# 默认：按内容自动判断，统一 LF，保证跨平台 diff 干净
* text=auto eol=lf

# 明确按文本处理
*.md   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.mjs  text eol=lf
*.js   text eol=lf
*.ps1  text eol=crlf
*.cmd  text eol=crlf

# 二进制不得被转换
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.ico  binary
*.zip  binary
*.tgz  binary
*.pdf  binary
